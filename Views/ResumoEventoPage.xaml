<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CadastroEventos.Views.ResumoEventoPage"
    Title="Resumo do Evento"
    BackgroundColor="#F2F5FA">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="18">

            <Label
                Text="Evento cadastrado!"
                FontSize="27"
                FontAttributes="Bold"
                TextColor="#173B70"
                HorizontalOptions="Center"/>

            <Label
                Text="Confira os dados do seu evento"
                FontSize="15"
                TextColor="Gray"
                HorizontalOptions="Center"/>

            <Border
                BackgroundColor="White"
                Stroke="#DCE3ED"
                StrokeThickness="1"
                Padding="20"
                StrokeShape="RoundRectangle 15">

                <VerticalStackLayout Spacing="13">

                    <Label
                        Text="INFORMAÃ‡Ã•ES DO EVENTO"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#173B70"/>

                    <Label Text="Nome do evento" FontAttributes="Bold"/>
                    <Label Text="{Binding Nome}" FontSize="17"/>

                    <Label Text="Data de inÃ­cio" FontAttributes="Bold"/>
                    <Label
                        Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"/>

                    <Label Text="Data de tÃ©rmino" FontAttributes="Bold"/>
                    <Label
                        Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}"/>

                    <Label Text="Participantes" FontAttributes="Bold"/>
                    <Label Text="{Binding NumeroParticipantes}"/>

                    <Label Text="Local" FontAttributes="Bold"/>
                    <Label Text="{Binding Local}"/>

                    <Label Text="Custo por participante" FontAttributes="Bold"/>
                    <Label
                        Text="{Binding CustoPorParticipante, StringFormat='R$ {0:N2}'}"/>

                    <BoxView HeightRequest="1" Color="#DCE3ED"/>

                    <Label
                        Text="DURAÃ‡ÃƒO DO EVENTO"
                        FontAttributes="Bold"
                        TextColor="#173B70"/>

                    <Label
                        Text="{Binding Duracao, StringFormat='{0:%d} dias'}"
                        FontSize="20"
                        FontAttributes="Bold"/>

                    <Label
                        Text="CUSTO TOTAL"
                        FontAttributes="Bold"
                        TextColor="#173B70"/>

                    <Label
                        Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#16834A"/>

                </VerticalStackLayout>
            </Border>

            <Button
                Text="VOLTAR AO CADASTRO"
                Clicked="Voltar_Clicked"
                BackgroundColor="#173B70"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="55"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
